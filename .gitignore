# ============================
# 1. 虚拟环境（必须忽略）
# ============================
agentVenv/
venv/
env/
python_ai_env/
*.pyenv/

# ============================
# 2. Python 编译缓存与打包文件
# ============================
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec

# ============================
# 3. Jupyter Notebook（防止检查点冲突）
# ============================
.ipynb_checkpoints/
*/.ipynb_checkpoints/
*.ipynb_checkpoints
*.html

# ============================
# 4. 数据文件（根据大小决定是否忽略，推荐先忽略）
# ============================
data/raw/*
data/processed/*
data/external/*
*.csv
*.xlsx
*.xls
*.json
*.db
*.sqlite
*.parquet

# 保留 data 文件夹的空目录结构（必须配合上面规则）
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# ============================
# 5. 模型文件（通常很大，不提交）
# ============================
models/*.pkl
models/*.h5
models/*.pt
models/*.pth
models/*.onnx
*.joblib

# 保留 models 文件夹的空目录结构
!models/.gitkeep

# ============================
# 6. 环境变量与密钥（绝不能提交！）
# ============================
.env
.env.local
.env.*.local
*.secret
*.key
*.pem

# ============================
# 7. IDE 与编辑器配置（建议忽略，避免团队冲突）
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode-server/

# ============================
# 8. 测试与代码覆盖率
# ============================
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ============================
# 9. 日志、报告与临时文件
# ============================
logs/
*.log
reports/
outputs/
*.tmp
*.temp
命令.txt
temp_*.py

# ============================
# 10. 特定于你的项目（根据你之前的截图）
# ============================
scripts/__pycache__/
src/__pycache__/
notebooks/.ipynb_checkpoints/